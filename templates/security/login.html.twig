<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>

    <h2>Login to Dashboard</h2>

    {% if error %}
        <div style="color: red;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

<form method="post">
    <input type="text" name="_username" placeholder="Email" required>
    <input type="password" name="_password" placeholder="Password" required>

    <button type="submit">Login</button>

    {# Mo cancel sa button#}
    <button type="button" onclick="window.location.href='{{ path('app_login') }}'">
        Cancel
    </button>
</form>

</body>
</html>
