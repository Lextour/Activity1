<!DOCTYPE html>
<html>
<head>
    <title>Dashboard - Protected Area</title>
    <style>
        body { 
            font-family: 'Arial', sans-serif; 
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .container {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            max-width: 600px;
            width: 90%;
        }
        
        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }
        
        .message {
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }
        
        .admin-message {
            background-color: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }
        
        .user-message {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 2px solid #bee5eb;
        }
        
        .user-info {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 4px solid #667eea;
        }
        
        .user-info p {
            margin: 8px 0;
            font-size: 16px;
        }
        
        .user-info strong {
            color: #495057;
        }
        
        .actions {
            text-align: center;
            margin-top: 30px;
        }
        
        .btn {
            display: inline-block;
            padding: 10px 20px;
            margin: 0 10px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s ease;
        }
        
        .btn:hover {
            background: #764ba2;
        }
        
        .btn-logout {
            background: #dc3545;
        }
        
        .btn-logout:hover {
            background: #c82333;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🏠 Dashboard</h1>
        
        <div class="message {{ messageClass }}">
            {{ message }}
        </div>
        
        <div class="user-info">
            <p><strong>👤 Username:</strong> {{ username }}</p>
            <p><strong>🔑 Roles:</strong> {{ roles|join(', ') }}</p>
            <p><strong>🔒 Status:</strong> Authenticated</p>
        </div>
        
        <div class="actions">
            <a href="{{ path('app_dashboard') }}" class="btn">🔄 Refresh</a>
            <a href="/logout" class="btn btn-logout">🚪 Logout</a>
        </div>
        
        <div style="text-align: center; margin-top: 20px; color: #6c757d; font-size: 14px;">
            <p>Symfony Security Activity 2 - In-Memory Authentication</p>
        </div>
    </div>
</body>
</html>